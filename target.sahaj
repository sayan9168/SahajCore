fn fib(n) {
    let a = 0
    let b = 1
    let i = 0
    while i < n {
        let t = a + b
        a = b
        b = t
        i = i + 1
    }
    return a
}

fn greet(name) {
    print("Hello, " + name + "!")
    return len(name)
}

let total = greet("SahajCore")
print("Name length: " + str(total))

let i = 0
while i < 10 {
    print("fib(" + str(i) + ") = " + str(fib(i)))
    i = i + 1
}

let x = 10
let y = 3
print("x + y = " + str(x + y))
print("x * y = " + str(x * y))

if x > y {
    print("x is greater")
} else {
    print("y is greater")
}
